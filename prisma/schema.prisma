generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Project {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  sets      MCQSet[]
}

model MCQSet {
  id          String   @id @default(uuid())
  projectId   String
  title       String
  topic       String
  level       String
  count       Int
  sharePin    String?  @unique
  createdAt   DateTime @default(now())

  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  questions   Question[]
  leaderboard LeaderboardEntry[]
}

model Question {
  id                 String  @id @default(uuid())
  setId              String
  text               String
  options            String[]
  correctOptionIndex Int
  solution           String
  notes              String

  set                MCQSet  @relation(fields: [setId], references: [id], onDelete: Cascade)
}

model LeaderboardEntry {
  id          String   @id @default(uuid())
  setId       String
  nickname    String
  score       Int
  totalCount  Int
  completedAt DateTime @default(now())

  set         MCQSet   @relation(fields: [setId], references: [id], onDelete: Cascade)
}
